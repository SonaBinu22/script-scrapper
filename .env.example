# Script Scrapper Environment Configuration Template
# DO NOT COMMIT SECRETS OR SENSITIVE PASSWORDS TO SOURCE CONTROL

PROJECT_NAME="Script Scrapper"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8000
UVICORN_WORKERS=2

# PostgreSQL 16 Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/script_scrapper"
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800.0
DB_ECHO=false

# Security
SECRET_KEY="replace-with-a-cryptographically-secure-random-key-in-production"
SESSION_EXPIRE_HOURS=24

# Storage Paths
STORAGE_DIR="D:\script-scrapper\storage"

# Network & Host Binding
LAN_SUBNET="192.168.1.0/24"
HOST_IP_OR_HOSTNAME="127.0.0.1"
