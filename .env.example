# SCRIPT SCRAPPER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local deployment. NEVER commit actual .env with production secrets.

# ==============================================================================
# Application & Host Configuration
# ==============================================================================
ENVIRONMENT=development
DEBUG=true
HOST_DOMAIN=localhost
HOST_IP=127.0.0.1
HOST_PORT=8000
SECRET_KEY=generate-a-secure-256-bit-secret-key-for-session-and-csrf-signing

# ==============================================================================
# Database Configuration (PostgreSQL 16)
# ==============================================================================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=script_scrapper
POSTGRES_USER=script_scrapper_user
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_POOL_MIN=10
POSTGRES_POOL_MAX=40

# ==============================================================================
# Storage Paths (Windows NTFS)
# ==============================================================================
STORAGE_ROOT=D:/script-scrapper/storage
MAX_UPLOAD_SIZE_MB=50

# ==============================================================================
# OCR Engine Configuration (Tesseract v5.3+)
# ==============================================================================
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_LANG=eng
OCR_DPI=300

# ==============================================================================
# Background Worker Configuration (PostgreSQL SKIP LOCKED)
# ==============================================================================
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_INTERVAL_SEC=5
WORKER_TIMEOUT_SEC=45

# ==============================================================================
# Email Dispatcher Configuration
# ==============================================================================
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=noreply@scriptscrapper.local

# ==============================================================================
# External AI API Configuration
# ==============================================================================
EXTERNAL_AI_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEFAULT_AI_PROVIDER=gemini
